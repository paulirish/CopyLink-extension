{
   "manifest_version": 3,
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "action": {
      "default_icon": {
        "64":  "icon64.png"
      },
      "default_title": "Copy HTML Link"
   },
   "description": "Copy link to the current page (with page title) to the clipboard.",
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "64": "icon64.png"
   },
   "name": "Copy HTML Link",

   "permissions": [ "activeTab", "clipboardWrite" , "contextMenus"],
   "version": "2.0"
}
